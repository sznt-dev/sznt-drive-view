#include <winver.h>
#include "sznt_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SZNT_VERSION_RC
 PRODUCTVERSION SZNT_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE SZNT_FILETYPE
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", SZNT_PUBLISHER
            VALUE "FileDescription", SZNT_FILE_DESC
            VALUE "FileVersion", SZNT_VERSION
            VALUE "InternalName", SZNT_INTERNAL
            VALUE "LegalCopyright", SZNT_COPYRIGHT
            VALUE "OriginalFilename", SZNT_ORIGINAL
            VALUE "ProductName", SZNT_PRODUCT
            VALUE "ProductVersion", SZNT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
