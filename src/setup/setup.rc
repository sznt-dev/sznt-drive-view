#include "setup_res.h"
#if SZNT_EDITION == 1
#define SZNT_FILE_DESC "SZNT Drive Setup - install, update and remove SZNT Drive"
#define SZNT_ORIGINAL  "SZNT-Drive-Setup.exe"
#define SZNT_PRODUCT   "SZNT Drive"
#elif SZNT_EDITION == 2
#define SZNT_FILE_DESC "SZNT View Setup - install, update and remove SZNT View"
#define SZNT_ORIGINAL  "SZNT-View-Setup.exe"
#define SZNT_PRODUCT   "SZNT View"
#else
#define SZNT_FILE_DESC "SZNT Drive + View Setup - install, update and remove SZNT Drive and SZNT View"
#define SZNT_ORIGINAL  "SZNT-Drive-View-Setup.exe"
#define SZNT_PRODUCT   "SZNT Drive + View"
#endif
#define SZNT_INTERNAL  "sznt-setup"
#define SZNT_FILETYPE  VFT_APP
#include "version_info.rc"

1 24 "setup.manifest"
IDI_APP ICON "sznt.ico"

301 RCDATA "fonts/SZNTWide-Regular.ttf"
302 RCDATA "fonts/SZNTDisplay-Regular.ttf"
303 RCDATA "fonts/SZNTSans-Regular.ttf"
304 RCDATA "fonts/SZNTSans-Medium.ttf"
305 RCDATA "fonts/SZNTSans-SemiBold.ttf"
306 RCDATA "fonts/SZNTMono-Medium.ttf"
307 RCDATA "fonts/SZNTMono-SemiBold.ttf"

#if SZNT_EDITION != 2
401 RCDATA "clips/drive.clip"
#endif
#if SZNT_EDITION != 1
402 RCDATA "clips/view.clip"
#endif
